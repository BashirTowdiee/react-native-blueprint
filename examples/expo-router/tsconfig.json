{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@react-native-blueprint/core": [
        "../../packages/core/src/index.ts"
      ],
      "@react-native-blueprint/react-native": [
        "../../packages/react-native/src/index.ts"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "design-system/**/*.ts",
    "design-system/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "store.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
