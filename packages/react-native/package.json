{
  "name": "@react-native-blueprint/react-native",
  "version": "0.2.0-dev.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    },
    "./babel": {
      "types": "./babel.d.cts",
      "default": "./babel.cjs"
    },
    "./devtools": {
      "types": "./devtools.d.cts",
      "default": "./devtools.cjs"
    }
  },
  "files": [
    "dist",
    "dev.js",
    "dev.d.ts",
    "babel.cjs",
    "babel.d.cts",
    "devtools.cjs",
    "devtools.d.cts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-native-blueprint/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  }
}
